# Local, personal configuration: copy this file to .env (git-ignored) and fill it in.
# Read by the scripts in scripts/. Never commit .env.

# --- SSH session (scripts/start-session.sh) ---
# Private keys in ~/.ssh to unlock once per session, separated by spaces.
SSH_KEYS="id_<type>_github id_<type>_ailb"

# --- Unimore AImageLab-HPC cluster (scripts/cluster/) ---
# Project-wide settings (partition, allowed GPUs) are in scripts/cluster/defaults.sh.
# SSH alias from ~/.ssh/config.
CLUSTER_HOST=ailb
# Slurm account for this project: run `susage` on the cluster.
CLUSTER_ACCOUNT="<project account>"
# Code mirror and Python environment (NFS home).
CLUSTER_HOME_DIR="/homes/<username>/tsmerge"
# Runs and temporary files (BeeGFS work area).
CLUSTER_WORK_DIR="/work/<project account>/<username>/tsmerge"
