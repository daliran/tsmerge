{
  // Shared workspace settings (PD-031). Personal preferences go in your user settings.
  // The project's environment, built by `uv sync`.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Ruff in the editor = Ruff in scripts/check.sh and the pre-commit hook:
  // - the same executable: the one in .venv, pinned by uv.lock (not the extension's own);
  // - the same rules: pyproject.toml wins over any personal editor setting;
  // - format on save, and sort imports on save (the lint rule I).
  "ruff.importStrategy": "fromEnvironment",
  "ruff.configurationPreference": "filesystemFirst",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  // ShellCheck in the editor = the one scripts/check.sh runs (installed with apt, setup.md),
  // not the extension's bundled copy; options come from .shellcheckrc for both.
  "shellcheck.executablePath": "/usr/bin/shellcheck",
  // The tests, in VS Code's Testing view.
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  // Line endings as in .gitattributes.
  "files.eol": "\n"
}
