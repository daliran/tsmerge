%% How a question becomes a decision, and how a decision changes over time.
%% Shown in docs/engineering/decisions/README.md.
stateDiagram-v2
  direction LR
  state "question open (EQ-NNNN)" as open
  state "investigating" as investigating
  state "decision proposed (ED-NNNN)" as proposed
  state "accepted" as accepted
  state "deleted (id never reused)" as deleted

  [*] --> open: something isn't decided
  open --> investigating: tests, docs, numbers
  investigating --> proposed: options and a recommendation
  open --> proposed
  proposed --> accepted: the user decides, and the question file is deleted
  proposed --> deleted: the user rejects it
  accepted --> accepted: new information or a changed choice: updated in place
  accepted --> deleted: it no longer holds
  [*] --> proposed: a change that needs no open question
