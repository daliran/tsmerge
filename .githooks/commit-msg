#!/usr/bin/env bash
# Rejects a commit message whose subject doesn't follow Conventional Commits
# (docs/project/workflow.md#commit-messages). Skip once: git commit --no-verify
set -euo pipefail

# The subject is the first line that is neither empty nor a comment.
subject=$(grep -v -e '^#' -e '^[[:space:]]*$' "$1" | head -n 1 || true)

# Messages git writes itself (merges, reverts, fixup/squash for rebases) are fine.
if [[ $subject =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
  exit 0
fi

types='feat|fix|docs|refactor|perf|test|build|ci|style|chore|revert'
pattern="^($types)(\([a-z0-9-]+\))?!?: [a-z0-9\`].*[^.]$"
problems=()
[[ $subject =~ $pattern ]] \
  || problems+=("expected '<type>(<scope>): <subject>': type one of $types, lowercase subject, no trailing period")
[[ ${#subject} -le 72 ]] || problems+=("subject is ${#subject} characters long; at most 72")

if [[ ${#problems[@]} -gt 0 ]]; then
  echo "commit message rejected: $subject" >&2
  printf '  - %s\n' "${problems[@]}" >&2
  exit 1
fi
