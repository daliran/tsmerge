%% The repository's folders, what each holds, and where to start reading.
%% Shown in docs/README.md.
flowchart LR
  subgraph start["Start here"]
    direction TB
    readme["README.md<br/>what the project is"]
    claude["CLAUDE.md<br/>rules for AI agents"]
    contributing["CONTRIBUTING.md<br/>git, checks, commits"]
  end

  subgraph docs["docs/engineering/: the technical work"]
    direction TB
    setup["setup.md<br/>once per machine"]
    running["running.md<br/>every day"]
    cluster["cluster.md<br/>cluster facts"]
    runsdoc["runs.md<br/>what a run records"]
    decisions["decisions/ ED-NNNN<br/>why things are so"]
    questions["questions/ EQ-NNNN<br/>what is still open"]
    diagrams["assets/<br/>pictures, beside each doc folder"]
  end

  subgraph research["docs/research/: the research"]
    direction TB
    literature["literature/<br/>paper notes, references.bib"]
    knowledge["knowledge/<br/>one concept per doc"]
    method["method/<br/>protocol, experiments, findings"]
    rdecisions["decisions/ RD-NNNN, questions/ RQ-NNNN<br/>why, and what is open"]
  end

  subgraph code["Code"]
    direction TB
    pkg["tsmerge/<br/>experiment code"]
    tests["tests/"]
    scripts["scripts/<br/>run_local, check, diagrams"]
    clusterscripts["scripts/cluster/<br/>submit, pull, status, logs"]
  end

  subgraph tooling["Configuration"]
    direction TB
    pyproject["pyproject.toml, uv.lock<br/>the environment"]
    githooks[".githooks/<br/>checks on commit"]
    vscode[".vscode/<br/>tasks, debugging, settings"]
    dotclaude[".claude/<br/>agent skills and hooks"]
  end

  subgraph local["Git-ignored, on your machine only"]
    direction TB
    outputs["outputs/<br/>runs, quick tries, reviews"]
    data["data/<br/>datasets"]
    papers["docs/research/literature/papers/<br/>PDFs, by bibkey"]
    env[".env, CLAUDE.local.md<br/>personal values"]
  end

  start ~~~ docs
  docs ~~~ research
  research ~~~ code
  code ~~~ tooling
  tooling ~~~ local
