# --- Everything generated locally: runs, quick tries, job records, review reports -----
outputs/

# --- Papers (ED-034): the PDFs stay local, beside their notes; the notes are committed --
/docs/research/literature/papers/

# --- Datasets (ED-020): the local data folder, and data files anywhere -------------
data/
*.parquet
*.npz
*.h5
*.hdf5
*.safetensors

# --- Model checkpoints --------------------------------------------------------
*.pt
*.pth
*.ckpt

# --- Claude Code: personal, machine-specific files ----------------------------
CLAUDE.local.md
.claude/settings.local.json

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Virtual environments (uv creates .venv/)
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# --- Editors and OS -----------------------------------------------------------
# VS Code: only the shared tasks, debug configurations, extensions and settings are
# committed (ED-031); everything else in .vscode/ stays personal.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
